---
import { Font } from "astro:assets";
import { type Lang, localeInfo } from "../i18n/locales";
import { alternateLinks, alternates, type RouteKey } from "../i18n/routes";
import "../styles/tokens.css";
import "../styles/base.css";

interface Props {
  lang: Lang;
  title: string;
  description: string;
  route: RouteKey;
}

const { lang, title, description, route } = Astro.props;
---

<!doctype html>
<html lang={localeInfo[lang].tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    {/* Preload only the body text face: Plex Sans, latin, upright. */}
    <Font cssVariable="--font-plex-sans" preload={[{ subset: "latin", style: "normal" }]} />
    <Font cssVariable="--font-plex-mono" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={alternates(route)[lang]} />
    {alternateLinks(route).map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>
