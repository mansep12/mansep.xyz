---
/**
 * Every page renders inside this layout. It owns the document head (title,
 * description, canonical, hreflang, Open Graph), the theme bootstrap, fonts,
 * header, <main id="main"> and footer.
 *
 * Usage:
 *   <BaseLayout lang="es" routeKey="project" params={{ slug }} title={entry.data.title}
 *     description={entry.data.summary}>
 *     ...
 *   </BaseLayout>
 */
import { Font } from "astro:assets";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import ThemeScript from "../components/ThemeScript.astro";
import type { Resume } from "../data/resume.schema";
import { site } from "../data/site";
import { type Lang, localeInfo, otherLangs } from "../i18n/locales";
import { absoluteUrl, alternateLinks, alternates, type PageRoute } from "../i18n/routes";
import { useTranslations } from "../i18n/ui";
import { BEACON_SRC, beaconConfig, getAnalyticsToken } from "../lib/analytics";
import {
  documentTitle as formatDocumentTitle,
  OG_IMAGE_HEIGHT,
  OG_IMAGE_WIDTH,
  ogImagePath,
} from "../lib/seo";
import { profilePageJsonLd, serializeJsonLd } from "../lib/structured-data";
import { themeColors } from "../lib/theme";
import "../styles/tokens.css";
import "../styles/base.css";

type Props = PageRoute & {
  lang: Lang;
  /** Page title without the site name; the home page shows the name only. */
  title: string;
  /** Meta and social description, one or two sentences. */
  description: string;
  /**
   * Social preview image: site-relative path or absolute URL (1200x630).
   * Defaults to the image generated at build time for the page's canonical
   * path (src/integrations/og-images.ts); pages outside the route map get none.
   */
  ogImage?: string;
  /** Keep the page out of search results. */
  noindex?: boolean;
  /**
   * Whether the page exists in every locale (default). Set to false for a
   * page that exists only in `lang`: no hreflang alternates, no language switch.
   * A page without `routeKey` (e.g. 404) is never treated as translated.
   */
  translated?: boolean;
  /**
   * CV data in `lang` for a page about the author (home, about): emits a
   * schema.org ProfilePage with the Person as main entity.
   */
  profile?: Resume;
};

const {
  lang,
  title,
  description,
  ogImage,
  noindex = false,
  translated = true,
  profile,
  ...route
} = Astro.props;

const t = useTranslations(lang);
const documentTitle = formatDocumentTitle(title, route.routeKey === "home");
const canonical = route.routeKey ? alternates(route.routeKey, route.params)[lang] : undefined;
const hreflangLinks =
  translated && route.routeKey ? alternateLinks(route.routeKey, route.params) : [];
const hasAlternates = hreflangLinks.length > 0;
const generatedOgImage =
  !ogImage && canonical ? ogImagePath(new URL(canonical).pathname) : undefined;
const ogImageSource = ogImage ?? generatedOgImage;
const ogImageUrl = ogImageSource ? absoluteUrl(ogImageSource) : undefined;
const analyticsToken = getAnalyticsToken();
const structuredData =
  profile && canonical
    ? profilePageJsonLd({
        url: canonical,
        title: documentTitle,
        inLanguage: localeInfo[lang].tag,
        resume: profile,
      })
    : undefined;
---

<!doctype html>
<html lang={localeInfo[lang].tag}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Layer order must precede every stylesheet, whatever order Vite bundles them in. */}
    <style is:inline>
      @layer reset, tokens, base, components, utilities;
    </style>
    <meta name="color-scheme" content="light dark" />
    {/* Before ThemeScript, which repoints them when a theme is forced. */}
    <meta name="theme-color" content={themeColors.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={themeColors.dark} media="(prefers-color-scheme: dark)" />
    <ThemeScript />
    {/* Preload only the body text face: Inter, latin, upright. */}
    <Font cssVariable="--font-inter" preload={[{ subset: "latin", style: "normal" }]} />
    <Font cssVariable="--font-plex-mono" />

    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {hreflangLinks.map(({ hreflang, href }) => <link rel="alternate" hreflang={hreflang} href={href} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={localeInfo[lang].ogLocale} />
    {
      hasAlternates &&
        otherLangs(lang).map((other) => (
          <meta property="og:locale:alternate" content={localeInfo[other].ogLocale} />
        ))
    }
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {
      generatedOgImage && (
        <>
          <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
          <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
          <meta property="og:image:alt" content={documentTitle} />
        </>
      )
    }
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {
      structuredData && (
        <script is:inline type="application/ld+json" set:html={serializeJsonLd(structuredData)} />
      )
    }
  </head>
  <body>
    {/* The 12 columns of the container, drawn as hairlines behind the page on wide screens. */}
    <div class="grid-hint" aria-hidden="true">
      <div class="container">{Array.from({ length: 12 }, () => <span />)}</div>
    </div>
    <a class="skip-link" href="#main">{t("skip.toContent")}</a>
    <SiteHeader lang={lang} translated={hasAlternates} {...route} />
    <main id="main" class="container">
      <slot />
    </main>
    <SiteFooter lang={lang} />
    {
      analyticsToken && (
        <script is:inline defer src={BEACON_SRC} data-cf-beacon={beaconConfig(analyticsToken)} />
      )
    }
  </body>
</html>

<style>
  @layer components {
    .skip-link {
      position: absolute;
      inset-block-start: var(--space-2xs);
      inset-inline-start: var(--space-2xs);
      z-index: 1;
      padding: var(--space-2xs) var(--space-xs);
      background-color: var(--color-surface);
      border: var(--border-width) solid var(--color-accent);
      border-radius: var(--radius);
      transform: translateY(-200%);
    }

    .skip-link:focus {
      transform: none;
    }

    /* Behind everything (the body has no background of its own), so boxes
       with a surface color cover the lines and text sits on top of them.
       Absolute in the body, so the lines run the full height of the page. */
    .grid-hint {
      display: none;
    }

    @media screen and (min-width: 64rem) {
      :global(body) {
        position: relative;
      }

      .grid-hint {
        display: block;
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
      }

      .grid-hint .container {
        display: grid;
        grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
        column-gap: var(--grid-gap);
        block-size: 100%;
      }

      .grid-hint span {
        border-inline-start: var(--border-width) solid var(--color-grid);
      }

      .grid-hint span:last-child {
        border-inline-end: var(--border-width) solid var(--color-grid);
      }
    }

    main {
      flex: 1;
      padding-block: var(--space-xl);
    }

    @media print {
      main {
        padding: 0;
      }
    }
  }
</style>
