---
/**
 * Goes in <head>, before any stylesheet: applies the stored theme before the
 * first paint. Without JavaScript the toggle cannot work, so it is hidden.
 */
import { themeInitScript } from "../lib/theme-init";
---

<script is:inline set:html={themeInitScript} />
<noscript><style>[data-theme-toggle]{display:none}</style></noscript>
