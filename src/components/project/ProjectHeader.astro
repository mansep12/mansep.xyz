---
/**
 * Case study header: back link, year and status, title, the one-line
 * description (the body's intro paragraph) and the headline outcome. The
 * title carries the project's number in the list ("01 / Nodus").
 */
import type { Lang } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import type { ProjectData } from "../../lib/content/schemas";
import { projectStrings } from "./strings";

interface Props {
  lang: Lang;
  data: ProjectData;
  /** HTML of the body's intro, rendered from the project's own Markdown. */
  intro: string;
  /** 1-based position in the projects list. */
  position: number;
}

const { lang, data, intro, position } = Astro.props;
const s = projectStrings[lang];
---

<header class="project-header flow">
  <p class="meta">
    <a href={localizedPath("projects", lang)}>{s.backToProjects}</a>
    <span aria-hidden="true">/</span>
    <span class="mono">{data.year}</span>
    <span aria-hidden="true">·</span>
    <span class="status">{s.status[data.status]}</span>
  </p>
  <h1 data-position={String(position).padStart(2, "0")}>{data.title}</h1>
  {intro && <div class="lede" set:html={intro} />}
  <p class="outcome">{data.outcome}</p>
</header>

<style>
  @layer components {
    .project-header {
      --flow-space: var(--space-s);
    }

    .meta {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: var(--space-3xs) var(--space-2xs);
      color: var(--color-muted);
      font-size: var(--step--1);
    }

    .status {
      padding-inline: var(--space-2xs);
      border: var(--border-width) solid var(--color-border);
      border-radius: var(--radius);
      color: var(--color-text);
      font-family: var(--font-mono);
    }

    /* The number is generated, so it stays out of the heading's text. */
    h1::before {
      content: attr(data-position) " /\00a0" / "";
      color: var(--color-muted);
      font-family: var(--font-mono);
      font-size: var(--step--1);
      font-weight: var(--font-weight-regular);
      letter-spacing: 0;
    }

    .lede :global(p) {
      font-size: var(--step-1);
      line-height: var(--leading-snug);
    }

    .outcome {
      padding-inline-start: var(--space-xs);
      border-inline-start: 2px solid var(--color-accent);
      font-weight: var(--font-weight-medium);
    }
  }
</style>
