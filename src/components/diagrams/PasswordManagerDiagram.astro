---
/**
 * Password manager: where keys are derived and what the server stores (from
 * frontend/src/encryption*.js, the signup and passwords pages and the
 * backend models). The highlighted arrow is the known weakness: the master
 * password also reaches the server.
 */
import type { Lang } from "../../i18n/locales";
import DiagramArrow from "./DiagramArrow.astro";
import DiagramBox from "./DiagramBox.astro";
import DiagramFigure from "./DiagramFigure.astro";
import { boxHeight } from "./layout";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const text = {
  es: {
    title: "Arquitectura del gestor de contraseñas",
    desc: "En el navegador, con la Web Crypto API, la contraseña maestra pasa por PBKDF2 con SHA-256, 100.000 iteraciones y una sal al azar, y deriva una llave AES-CBC de 256 bits; cada usuario tiene además un par RSA-OAEP de 2048 bits generado en el navegador. Al servidor llegan el texto cifrado, los IV, la sal, la llave pública y la llave privada cifrada, pero también la contraseña maestra, que la API en FastAPI usa para el inicio de sesión con JWT y guarda como hash bcrypt. La base SQLite guarda usuarios con su sal y sus llaves, contraseñas cifradas con AES-CBC con nombre, URL y usuario en claro, y contraseñas compartidas cifradas con la llave pública del destinatario.",
    caption:
      "Las llaves se derivan en el navegador y el servidor guarda texto cifrado; la flecha resaltada es la debilidad conocida: la contraseña maestra también llega al servidor.",
    browser: {
      title: "Navegador (Web Crypto API)",
      lines: [
        "PBKDF2 (SHA-256, 100.000 iteraciones, sal)",
        "deriva una llave AES-CBC de 256 bits",
        "par RSA-OAEP de 2048 bits por usuario",
      ],
    },
    api: {
      title: "API FastAPI",
      lines: ["sesión con JWT; guarda un hash", "bcrypt de la contraseña maestra"],
    },
    db: {
      title: "SQLite (SQLModel)",
      lines: [
        "users: sal, llave pública y privada cifrada",
        "passwords: cifrado AES-CBC e IV;",
        "nombre, URL y usuario en claro",
        "shared: cifrado con la llave pública",
        "del destinatario",
      ],
    },
    ciphertext: "cifrado, IV, sal y llaves",
    master: "también la contraseña maestra",
  },
  en: {
    title: "Password manager architecture",
    desc: "In the browser, with the Web Crypto API, the master password goes through PBKDF2 with SHA-256, 100,000 iterations and a random salt, deriving a 256-bit AES-CBC key; each user also has a 2048-bit RSA-OAEP key pair generated in the browser. The server receives the ciphertext, the IVs, the salt, the public key and the encrypted private key, but also the master password, which the FastAPI API uses for JWT login and stores as a bcrypt hash. The SQLite database stores users with their salt and keys, passwords encrypted with AES-CBC with name, URL and username in clear, and shared passwords encrypted with the recipient's public key.",
    caption:
      "Keys are derived in the browser and the server stores ciphertext; the highlighted arrow is the known weakness: the master password also reaches the server.",
    browser: {
      title: "Browser (Web Crypto API)",
      lines: [
        "PBKDF2 (SHA-256, 100,000 iterations, salt)",
        "derives a 256-bit AES-CBC key",
        "2048-bit RSA-OAEP key pair per user",
      ],
    },
    api: {
      title: "FastAPI API",
      lines: ["JWT sessions; stores a bcrypt", "hash of the master password"],
    },
    db: {
      title: "SQLite (SQLModel)",
      lines: [
        "users: salt, public and encrypted private key",
        "passwords: AES-CBC ciphertext and IV;",
        "name, URL and username in clear",
        "shared: encrypted with the",
        "recipient's public key",
      ],
    },
    ciphertext: "ciphertext, IV, salt and keys",
    master: "also the master password",
  },
}[lang];

const id = "diagram-password-manager";
const GAP = 64;
const browserH = boxHeight(3);
const apiY = 10 + browserH + GAP;
const apiH = boxHeight(2);
const dbY = apiY + apiH + 44;
const dbH = boxHeight(5);
const height = dbY + dbH + 10;
const gapTop = 10 + browserH;
---

<DiagramFigure
  id={id}
  height={height}
  title={text.title}
  desc={text.desc}
  caption={text.caption}
>
  <DiagramBox x={10} y={10} w={340} {...text.browser} accent />
  <DiagramBox x={10} y={apiY} w={340} {...text.api} />
  <DiagramBox x={10} y={dbY} w={340} {...text.db} />

  <DiagramArrow
    id={id}
    d={`M 40 ${gapTop} V ${apiY}`}
    variant="accent"
    label={{ x: 48, y: gapTop + 22, text: text.ciphertext }}
  />
  <DiagramArrow
    id={id}
    d={`M 320 ${gapTop} V ${apiY}`}
    variant="warn"
    dashed
    label={{ x: 312, y: gapTop + 46, text: text.master, anchor: "end" }}
  />
  <DiagramArrow id={id} d={`M 180 ${apiY + apiH} V ${dbY}`} />
</DiagramFigure>
