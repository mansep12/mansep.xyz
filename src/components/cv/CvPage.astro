---
/**
 * CV page for one locale: a print button (the browser saves the PDF) and
 * the full CV from src/data/resume.<lang>.json.
 */
import type { Lang } from "../../i18n/locales";
import { useTranslations } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getResume } from "../../lib/content";
import CvDocument from "./CvDocument.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const resume = await getResume(lang);
---

<BaseLayout lang={lang} routeKey="cv" title={t("cv.title")} description={t("cv.description")}>
  <div class="cv-page">
    <div class="toolbar" data-print-hidden>
      <button type="button" class="print-button" data-print hidden>{t("cv.download")}</button>
      <p class="hint">{t("cv.hint")}</p>
    </div>

    {
      /*
       * CV GENERATOR (package 4): the form to tailor this CV to a job offer
       * goes here, above the document. It renders the tailored resume with
       * the same <CvDocument>, and the full CV stays one click away.
       */
    }

    <CvDocument lang={lang} resume={resume} />
  </div>
</BaseLayout>

<script>
  import "../../scripts/print-button";
</script>

<style>
  @layer components {
    .cv-page {
      display: grid;
      gap: var(--space-m);
    }

    .toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2xs) var(--space-s);
    }

    .print-button {
      min-block-size: 2.5rem;
      padding: var(--space-2xs) var(--space-s);
      border: var(--border-width) solid var(--color-accent);
      border-radius: var(--radius);
      background-color: var(--color-accent);
      color: var(--color-bg);
      font-weight: var(--font-weight-medium);
      cursor: pointer;
      transition: background-color var(--duration) var(--ease);
    }

    .print-button:hover {
      background-color: var(--color-text);
      border-color: var(--color-text);
    }

    .print-button[hidden] {
      display: none;
    }

    .hint {
      color: var(--color-muted);
      font-size: var(--step--1);
    }
  }
</style>
