---
/**
 * CV page for one locale: a print button (the browser saves the PDF), the
 * CV generator form when the build enables it, and the full CV from
 * src/data/resume.<lang>.json. A tailored CV replaces the full one on screen
 * and in print until the visitor asks for the full one again.
 */
import type { Lang } from "../../i18n/locales";
import { useTranslations } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getResume } from "../../lib/content";
import { getGeneratorBuildConfig } from "../../lib/cv-generator/build-config";
import CvDocument from "./CvDocument.astro";
import CvGenerator from "./CvGenerator.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const resume = await getResume(lang);
const generator = getGeneratorBuildConfig();
---

<BaseLayout lang={lang} routeKey="cv" title={t("cv.title")} description={t("cv.description")}>
  <div class="cv-page">
    <div class="toolbar" data-print-hidden>
      <button type="button" class="print-button" data-print hidden>{t("cv.download")}</button>
      <p class="hint">{t("cv.hint")}</p>
    </div>

    {generator.enabled && <CvGenerator lang={lang} siteKey={generator.siteKey} />}

    <div class="full" data-cv-full tabindex="-1">
      <CvDocument lang={lang} resume={resume} />
    </div>
  </div>
</BaseLayout>

<script>
  import "../../scripts/print-button";
</script>

<style>
  @layer components {
    .cv-page {
      display: grid;
      gap: var(--space-m);
    }

    .toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2xs) var(--space-s);
    }

    .print-button {
      min-block-size: 2.5rem;
      padding: var(--space-2xs) var(--space-s);
      border: var(--border-width) solid var(--color-accent);
      border-radius: var(--radius);
      background-color: var(--color-accent);
      color: var(--color-bg);
      font-weight: var(--font-weight-medium);
      cursor: pointer;
      transition: background-color var(--duration) var(--ease);
    }

    .print-button:hover {
      background-color: var(--color-text);
      border-color: var(--color-text);
    }

    .print-button[hidden] {
      display: none;
    }

    .hint {
      color: var(--color-muted);
      font-size: var(--step--1);
    }

    .full[hidden] {
      display: none;
    }

    .full:focus {
      outline: none;
    }

    /* The generator and the sheet span nine of the twelve columns. */
    @media screen and (min-width: 64rem) {
      .cv-page {
        grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
        column-gap: var(--grid-gap);
      }

      .cv-page > * {
        grid-column: 1 / -1;
      }

      .cv-page > .full,
      .cv-page > :global(.generator) {
        grid-column: 1 / span 9;
      }

      .full > :global(.cv) {
        max-inline-size: none;
      }
    }
  }
</style>
