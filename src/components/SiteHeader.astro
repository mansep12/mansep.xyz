---
/**
 * One-line header: mark and name (home link), main navigation, language
 * switch and theme toggle. Below 48rem the navigation wraps to its own row;
 * from 64rem the three parts sit on the 12-column grid (name on 1-5, the
 * navigation from column 6, like the project list on the home page).
 */
import { site } from "../data/site";
import type { Lang } from "../i18n/locales";
import { localizedPath, type PageRoute, type RouteKey } from "../i18n/routes";
import { type UiKey, useTranslations } from "../i18n/ui";
import LanguageSwitch from "./LanguageSwitch.astro";
import MerkleMark from "./MerkleMark.astro";
import ThemeToggle from "./ThemeToggle.astro";

type Props = PageRoute & {
  lang: Lang;
  /** Show the language switch (false when the page has no translation). */
  translated: boolean;
};

const { lang, translated, ...route } = Astro.props;
const t = useTranslations(lang);

interface NavItem {
  readonly key: Exclude<RouteKey, "project">;
  readonly label: UiKey;
  /** Other routes that belong to this section (marked as current too). */
  readonly section?: readonly RouteKey[];
}

const navItems: readonly NavItem[] = [
  { key: "projects", label: "nav.projects", section: ["project"] },
  { key: "research", label: "nav.research" },
  { key: "about", label: "nav.about" },
  { key: "cv", label: "nav.cv" },
];

function current(item: NavItem): "page" | "true" | undefined {
  const { routeKey } = route;
  if (!routeKey) return undefined;
  if (item.key === routeKey) return "page";
  return item.section?.includes(routeKey) ? "true" : undefined;
}
---

<header class="site-header">
  <div class="container inner">
    <a
      class="site-name"
      href={localizedPath("home", lang)}
      aria-current={route.routeKey === "home" ? "page" : undefined}
    >
      <MerkleMark reveal={route.routeKey === "home"} />
      <span class="name">{site.name}</span>
    </a>
    <nav class="site-nav" aria-label={t("nav.label")}>
      <ul role="list">
        {
          navItems.map((item) => (
            <li>
              <a href={localizedPath(item.key, lang)} aria-current={current(item)}>
                {t(item.label)}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="tools">
      {translated && route.routeKey && <LanguageSwitch lang={lang} {...route} />}
      <ThemeToggle lang={lang} />
    </div>
  </div>
</header>

<style>
  @layer components {
    .site-header {
      border-block-end: var(--border-width) solid var(--color-border);
    }

    .inner {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      column-gap: var(--space-m);
      row-gap: var(--space-2xs);
      padding-block: var(--space-xs);
    }

    .site-name {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2xs);
      margin-inline-end: auto;
      color: var(--color-text);
      font-weight: var(--font-weight-bold);
      letter-spacing: var(--tracking-heading);
      text-decoration-line: none;
    }

    .tools {
      display: flex;
      align-items: center;
      gap: var(--space-xs);
    }

    .site-nav {
      order: 1;
      flex-basis: 100%;
    }

    .site-nav ul {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--space-s);
      row-gap: var(--space-3xs);
    }

    .site-nav a {
      color: var(--color-text);
      font-size: var(--step--1);
      font-weight: var(--font-weight-medium);
      text-decoration-line: none;
    }

    .site-name:hover .name,
    .site-nav a:hover,
    .site-nav a[aria-current] {
      text-decoration-line: underline;
      text-decoration-color: var(--color-accent);
      text-decoration-thickness: 2px;
      text-underline-offset: 0.35em;
    }

    @media (min-width: 48rem) {
      .site-name {
        margin-inline-end: 0;
      }

      .site-nav {
        order: 0;
        flex-basis: auto;
        margin-inline-start: auto;
      }
    }

    @media (min-width: 64rem) {
      .inner {
        display: grid;
        grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
        column-gap: var(--grid-gap);
      }

      .site-name {
        grid-column: 1 / span 5;
        justify-self: start;
      }

      .site-nav {
        grid-column: 6 / span 4;
        margin-inline-start: 0;
      }

      .tools {
        grid-column: 10 / -1;
        justify-self: end;
      }
    }
  }
</style>
