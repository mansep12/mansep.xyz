---
/**
 * About page for one locale: the bio from src/content/pages/<lang>/about.md,
 * then experience and education from the CV data, a stack line and an
 * "off the clock" line.
 */
import { render } from "astro:content";
import type { Lang } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { useTranslations } from "../../i18n/ui";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPage, getResume } from "../../lib/content";
import { joinLowercase } from "../../lib/text";
import EducationList from "./EducationList.astro";
import ExperienceList from "./ExperienceList.astro";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const page = await getPage(lang, "about");
const { Content } = await render(page);
const resume = await getResume(lang);
const interests = resume.interests.map((interest) => interest.name);
---

<BaseLayout
  lang={lang}
  routeKey="about"
  title={page.data.title}
  description={page.data.description}
  profile={resume}
>
  <div class="about numbered">
    <header class="flow">
      <h1>{page.data.title}</h1>
    </header>

    <div class="bio prose">
      <Content />
      <p>{t("contact.availability")}</p>
    </div>

    <section aria-labelledby="about-experience">
      <h2 id="about-experience" class="index">{t("about.experience")}</h2>
      <ExperienceList lang={lang} work={resume.work} />
    </section>

    <section aria-labelledby="about-education">
      <h2 id="about-education" class="index">{t("about.education")}</h2>
      <EducationList lang={lang} education={resume.education} />
    </section>

    <dl class="lines">
      <div>
        <dt>{t("about.stack")}</dt>
        <dd class="mono">{t("about.stackList")}</dd>
      </div>
      {
        interests.length > 0 && (
          <div>
            <dt>{t("about.offTheClock")}</dt>
            <dd>{joinLowercase(interests, lang)}</dd>
          </div>
        )
      }
    </dl>

    <p><a href={localizedPath("cv", lang)}>{t("about.cvLink")}</a></p>
  </div>
</BaseLayout>

<style>
  @layer components {
    .about {
      display: grid;
      gap: var(--space-xl);
    }

    .bio {
      font-size: var(--step-0);
    }

    section {
      display: grid;
      gap: var(--space-m);
    }

    h2 {
      font-size: var(--step-2);
    }

    .lines {
      display: grid;
      gap: var(--space-xs);
      max-inline-size: var(--measure);
    }

    .lines dt {
      color: var(--color-muted);
      font-size: var(--step--1);
    }

    .lines dd {
      margin: 0;
    }

    .lines dd::first-letter {
      text-transform: uppercase;
    }
  }
</style>
