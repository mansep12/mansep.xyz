---
/**
 * Work entries from the CV data: role, organization, dates, summary and
 * every highlight.
 */
import type { Resume } from "../../data/resume.schema";
import type { Lang } from "../../i18n/locales";
import { formatDateRange } from "../../lib/dates";

interface Props {
  lang: Lang;
  work: Resume["work"];
}

const { lang, work } = Astro.props;
---

<ol role="list" class="timeline">
  {
    work.map((job) => (
      <li class="item">
        <h3>{job.position}</h3>
        <p class="org">
          {job.url ? <a href={job.url}>{job.name}</a> : job.name}
          {job.location && <span class="muted"> · {job.location}</span>}
        </p>
        <p class="dates mono">{formatDateRange(job.startDate, job.endDate, lang)}</p>
        {job.summary && <p class="summary">{job.summary}</p>}
        {job.highlights.length > 0 && (
          <ul class="highlights">
            {job.highlights.map((highlight) => (
              <li>{highlight.text}</li>
            ))}
          </ul>
        )}
      </li>
    ))
  }
</ol>

<style>
  @layer components {
    .timeline {
      display: grid;
      gap: var(--space-l);
    }

    .item {
      display: grid;
      gap: var(--space-3xs);
      max-inline-size: var(--measure);
    }

    h3 {
      font-size: var(--step-1);
    }

    .dates {
      color: var(--color-muted);
      font-size: var(--step--1);
    }

    .summary {
      margin-block-start: var(--space-2xs);
    }

    .highlights {
      display: grid;
      gap: var(--space-2xs);
      margin-block-start: var(--space-2xs);
      padding-inline-start: 1.25em;
    }
  }
</style>
