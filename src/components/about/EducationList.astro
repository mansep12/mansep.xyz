---
/** Education entries from the CV data: degree, institution, dates and summary. */
import type { Resume } from "../../data/resume.schema";
import type { Lang } from "../../i18n/locales";
import { formatDateRange } from "../../lib/dates";

interface Props {
  lang: Lang;
  education: Resume["education"];
}

const { lang, education } = Astro.props;
---

<ul role="list" class="education">
  {
    education.map((item) => (
      <li class="item">
        <h3>{item.studyType ?? item.area ?? item.institution}</h3>
        <p class="org">{item.url ? <a href={item.url}>{item.institution}</a> : item.institution}</p>
        <p class="dates mono">{formatDateRange(item.startDate, item.endDate, lang)}</p>
        {item.summary && <p class="summary">{item.summary}</p>}
      </li>
    ))
  }
</ul>

<style>
  @layer components {
    .education {
      display: grid;
      gap: var(--space-m);
    }

    .item {
      display: grid;
      gap: var(--space-3xs);
      max-inline-size: var(--measure);
    }

    h3 {
      font-size: var(--step-1);
    }

    .dates {
      color: var(--color-muted);
      font-size: var(--step--1);
    }

    .summary {
      color: var(--color-muted);
    }
  }
</style>
