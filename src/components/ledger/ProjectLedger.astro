---
/**
 * Projects as the rows of a table: a mono number and the title (linking to
 * the project page), one line below it, and year and status in mono on the
 * right. `detailed` adds the summary, role, stack and outbound links
 * (projects index); from 64rem those rows use the 12-column grid, with the
 * facts in the right-hand columns. With no projects it renders a one-line
 * empty state.
 */
import { site } from "../../data/site";
import { projectStatusLabels } from "../../i18n/labels";
import type { Lang } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { useTranslations } from "../../i18n/ui";
import { entrySlug, type ProjectEntry } from "../../lib/content";
import { displayUrl } from "../../lib/urls";

interface Props {
  lang: Lang;
  projects: readonly ProjectEntry[];
  /** Add summary, role, stack and links to each row. */
  detailed?: boolean;
  /** Level of each project title, under the section heading. */
  headingLevel?: 2 | 3;
}

const { lang, projects, detailed = false, headingLevel = 3 } = Astro.props;
const t = useTranslations(lang);
const Heading = headingLevel === 2 ? "h2" : "h3";
---

{
  projects.length === 0 ? (
    <p class="empty muted">
      {t("projects.empty")} <a href={site.links.github}>{displayUrl(site.links.github)}</a>.
    </p>
  ) : (
    <ol role="list" class:list={["ledger", "numbered", { detailed }]}>
      {projects.map((project) => {
        const { title, summary, outcome, year, status, role, stack, links } = project.data;
        return (
          <li class="row">
            <div class="entry">
              <Heading class="title index">
                <a href={localizedPath("project", lang, { slug: entrySlug(project) })}>{title}</a>
              </Heading>
              {detailed && <p class="summary">{summary}</p>}
              <p class="outcome">{outcome}</p>
              {detailed && (
                <dl class="facts">
                  <div>
                    <dt>{t("projects.role")}</dt>
                    <dd>{role}</dd>
                  </div>
                  <div>
                    <dt>{t("projects.stack")}</dt>
                    <dd>
                      <ul role="list" class="stack mono">
                        {stack.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </dd>
                  </div>
                </dl>
              )}
              {detailed && (
                <ul role="list" class="links">
                  {links.repo && (
                    <li>
                      <a href={links.repo}>{t("projects.repo")}</a>
                    </li>
                  )}
                  {links.demo && (
                    <li>
                      <a href={links.demo}>{t("projects.demo")}</a>
                    </li>
                  )}
                  {links.video && (
                    <li>
                      <a href={links.video}>{t("projects.video")}</a>
                    </li>
                  )}
                </ul>
              )}
            </div>
            <p class="meta mono">
              <span class="visually-hidden">{t("projects.year")}: </span>
              {year}
              <span aria-hidden="true"> · </span>
              <span class="visually-hidden">. {t("projects.status")}: </span>
              {t(projectStatusLabels[status])}
            </p>
          </li>
        );
      })}
    </ol>
  )
}

<style>
  @layer components {
    /* A heavy rule on top, hairlines between rows: a table without a header. */
    .ledger {
      border-block-start: var(--border-width) solid var(--color-text);
    }

    .row {
      display: grid;
      gap: var(--space-3xs);
      padding-block: var(--space-s);
      border-block-end: var(--border-width) solid var(--color-border);
    }

    /* The entry's children are laid out by the row's grid. */
    .entry {
      display: contents;
    }

    .title {
      font-size: var(--step-1);
    }

    .title a {
      color: var(--color-text);
      text-decoration-line: none;
    }

    .title a:hover {
      color: var(--color-accent);
      text-decoration-line: underline;
    }

    .outcome {
      color: var(--color-muted);
    }

    .detailed .outcome {
      color: var(--color-text);
    }

    .detailed .summary {
      color: var(--color-muted);
    }

    .meta {
      color: var(--color-muted);
      font-size: var(--step--1);
      white-space: nowrap;
    }

    .facts {
      display: grid;
      gap: var(--space-3xs);
      margin-block-start: var(--space-2xs);
      font-size: var(--step--1);
    }

    .facts div {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--space-2xs);
    }

    .facts dt {
      color: var(--color-muted);
    }

    .facts dt::after {
      content: ":";
    }

    .facts dd {
      margin: 0;
    }

    .stack {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--space-2xs);
      font-size: 1em;
    }

    .stack li:not(:last-child)::after {
      content: " ·";
      color: var(--color-muted);
    }

    .links {
      display: flex;
      flex-wrap: wrap;
      column-gap: var(--space-s);
      margin-block-start: var(--space-3xs);
      font-size: var(--step--1);
    }

    /* Title on the left and year and status on the right, on one line;
       the rest of the row runs the full width below them. */
    @media (min-width: 40rem) {
      .row {
        grid-template-columns: minmax(0, 1fr) auto;
        column-gap: var(--space-m);
        align-items: baseline;
      }

      .entry > * {
        grid-column: 1 / -1;
      }

      .entry > .title {
        grid-column: 1;
      }

      .meta {
        grid-column: 2;
        grid-row: 1;
        text-align: end;
      }
    }

    /* Projects index: the row is the page's 12-column grid, text on 1-7,
       year, status and facts on 9-12. */
    @media (min-width: 64rem) {
      .detailed .row {
        grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
        column-gap: var(--grid-gap);
        padding-block: var(--space-m);
      }

      .detailed .entry > *,
      .detailed .entry > .title {
        grid-column: 1 / span 7;
      }

      .detailed .title {
        font-size: var(--step-2);
      }

      .detailed .meta {
        grid-column: 9 / -1;
        grid-row: 1;
        text-align: start;
      }

      .detailed .entry > .facts {
        grid-column: 9 / -1;
        grid-row: 2 / span 3;
        align-self: start;
        margin-block-start: 0;
      }

      .detailed .facts div {
        display: grid;
        gap: 0;
      }

      .detailed .facts dt::after {
        content: none;
      }
    }
  }
</style>
