---
/**
 * Three-state theme button (system, light, dark). The visible state is
 * picked by CSS from <html data-theme>, so it is right before any script
 * runs; the script keeps aria-label in sync and handles clicks. On narrow
 * phones only the icon shows (the aria-label still names the state), so the
 * name and the tools fit on one row.
 */
import type { Lang } from "../i18n/locales";
import { useTranslations } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  aria-label={t("theme.aria.system")}
  title={t("theme.aria.system")}
  data-label-system={t("theme.aria.system")}
  data-label-light={t("theme.aria.light")}
  data-label-dark={t("theme.aria.dark")}
>
  <span class="state" data-state="system">
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <path d="M8 2a6 6 0 0 1 0 12z" fill="currentColor"></path>
    </svg>
    <span class="label">{t("theme.system")}</span>
  </span>
  <span class="state" data-state="light">
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
      <path
        d="M8 1v2M8 13v2M1 8h2M13 8h2M3 3l1.4 1.4M11.6 11.6 13 13M3 13l1.4-1.4M11.6 4.4 13 3"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"></path>
    </svg>
    <span class="label">{t("theme.light")}</span>
  </span>
  <span class="state" data-state="dark">
    <svg viewBox="0 0 16 16" aria-hidden="true">
      <path
        d="M13.5 10A6 6 0 0 1 6 2.5a6 6 0 1 0 7.5 7.5z"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linejoin="round"></path>
    </svg>
    <span class="label">{t("theme.dark")}</span>
  </span>
</button>

<script>
  import "../scripts/theme-toggle";
</script>

<style>
  @layer components {
    .theme-toggle {
      display: inline-flex;
      align-items: center;
      min-block-size: 2rem;
      padding: var(--space-3xs) var(--space-2xs);
      border: var(--border-width) solid var(--color-border);
      border-radius: var(--radius);
      background-color: transparent;
      color: var(--color-muted);
      font-size: var(--step--1);
      line-height: 1;
      cursor: pointer;
      transition:
        color var(--duration) var(--ease),
        border-color var(--duration) var(--ease);
    }

    .theme-toggle:hover {
      color: var(--color-text);
      border-color: var(--color-muted);
    }

    .state {
      display: none;
      align-items: center;
      gap: var(--space-3xs);
    }

    svg {
      inline-size: 1em;
      block-size: 1em;
      flex: none;
    }

    @media (max-width: 26rem) {
      .theme-toggle {
        min-inline-size: 2rem;
        justify-content: center;
      }

      .label {
        position: absolute;
        inline-size: 1px;
        block-size: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
    }

    :global(:root:not([data-theme])) .state[data-state="system"],
    :global(:root[data-theme="light"]) .state[data-state="light"],
    :global(:root[data-theme="dark"]) .state[data-state="dark"] {
      display: inline-flex;
    }
  }
</style>
