---
import { researchKindLabels } from "../../i18n/labels";
/**
 * A research entry in short (kind, title, institution, one-line summary,
 * status) with a link to the research page.
 */
import type { Lang } from "../../i18n/locales";
import { localizedPath } from "../../i18n/routes";
import { useTranslations } from "../../i18n/ui";
import type { ResearchEntry } from "../../lib/content";

interface Props {
  lang: Lang;
  entry: ResearchEntry;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const { title, summary, institution, status, kind } = entry.data;
---

<article class="research-card flow">
  <p class="kind mono">{t(researchKindLabels[kind])} · {institution}</p>
  <h3>{title}</h3>
  <p>{summary}</p>
  <p class="status">{status}</p>
  <p><a href={localizedPath("research", lang)}>{t("home.researchLink")}</a></p>
</article>

<style>
  @layer components {
    .research-card {
      --flow-space: var(--space-2xs);
      max-inline-size: var(--measure);
      padding: var(--space-s);
      background-color: var(--color-surface);
      border: var(--border-width) solid var(--color-border);
      border-radius: var(--radius);
    }

    h3 {
      font-size: var(--step-1);
    }

    .kind,
    .status {
      color: var(--color-muted);
      font-size: var(--step--1);
    }
  }
</style>
