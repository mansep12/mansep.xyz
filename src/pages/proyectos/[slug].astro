---
import ProjectPage from "../../components/project/ProjectPage.astro";
import { entrySlug, findCounterpart, getProjects, type ProjectEntry } from "../../lib/content";

export async function getStaticPaths() {
  const projects = await getProjects("es");
  return Promise.all(
    projects.map(async (entry) => ({
      params: { slug: entrySlug(entry) },
      props: { entry, translated: Boolean(await findCounterpart("projects", entry, "en")) },
    })),
  );
}

interface Props {
  entry: ProjectEntry;
  translated: boolean;
}

const { entry, translated } = Astro.props;
---

<ProjectPage lang="es" entry={entry} translated={translated} />
