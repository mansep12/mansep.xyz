---
import { site } from "../data/site";
import { t } from "../i18n/ui";
import BaseLayout from "../layouts/BaseLayout.astro";

const lang = "es";
---

<BaseLayout lang={lang} title={site.name} description={site.tagline} route="home">
  <main>
    <h1>{site.name}</h1>
    <p>{site.tagline}</p>
    <p>{t(lang, "home.status")}</p>
  </main>
</BaseLayout>
