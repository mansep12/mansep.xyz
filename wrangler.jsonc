{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mansep-xyz",
  // Custom entrypoint: the Astro Cloudflare adapter's handler plus the CV
  // generator's Durable Object class (src/worker.ts).
  "main": "./src/worker.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get the nearest 404.html (src/pages/404.astro) with a 404 status.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // Serve the site on the apex domain. Cloudflare creates the DNS record and
  // the certificate. A www redirect, if added, lives in the zone settings.
  "routes": [{ "pattern": "mansep.xyz", "custom_domain": true }],
  // CV generator (docs/decisions/0009-cv-generator.md). Non-secret limits
  // live here. CV_GENERATOR_ENABLED is set in the dashboard and survives
  // deploys (keep_vars), so it works as a kill switch without a deploy.
  // Secrets: ANTHROPIC_API_KEY, TURNSTILE_SECRET_KEY (wrangler secret put).
  "keep_vars": true,
  "vars": {
    "CV_DAILY_LIMIT": "15",
    "CV_PER_IP_DAILY_LIMIT": "3",
    "TURNSTILE_HOSTNAMES": "mansep.xyz"
  },
  // Daily counters for the CV generator: one SQLite-backed Durable Object.
  "durable_objects": {
    "bindings": [{ "name": "CV_BUDGET", "class_name": "CvBudget" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CvBudget"] }]
}
