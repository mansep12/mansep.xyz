{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mansep-xyz",
  // Worker entrypoint provided by the Astro Cloudflare adapter.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown paths get the nearest 404.html (src/pages/404.astro) with a 404 status.
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  },
  // Serve the site on the apex domain. Cloudflare creates the DNS record and
  // the certificate. A www redirect, if added, lives in the zone settings.
  "routes": [{ "pattern": "mansep.xyz", "custom_domain": true }]
}
